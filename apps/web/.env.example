# Where the FastAPI backend runs (must be listed in the backend's CORS_ORIGINS).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Hosted deployment (Vercel): the browser calls this app's own proxy, which holds the key.
#   NEXT_PUBLIC_API_URL=/api/backend
#   BACKEND_URL=https://<your-api-address>
#   BACKEND_API_KEY=<the API key>       # server-side only; never prefix with NEXT_PUBLIC_
#   BACKEND_ALLOW_WRITES=1              # private deployments only; the default is a read-and-ask demo
