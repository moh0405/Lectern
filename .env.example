############################################
# AI Study Mentor - Environment Variables   #
############################################

# Google Gemini API key (cloud inference)
GEMINI_API_KEY=

# Optional: select Gemini model; defaults to a cost-efficient text model
# Examples: gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash

# Optional: default temperature for generation
GEMINI_TEMPERATURE=0.2