############################################
# AI Study Mentor - Environment Variables   #
############################################

# Google Gemini API key (cloud inference)
GEMINI_API_KEY=

# Optional: select Gemini model; defaults to a widely available, fast model
# Recommended examples: gemini-flash-latest, gemini-pro-latest
GEMINI_MODEL=gemini-3.8-flash

# Optional: default temperature for generation
GEMINI_TEMPERATURE=0.2
# Which language model answers: gemini (default) or openai (OpenAI or any OpenAI-compatible server)
LLM_PROVIDER=gemini

# Optional: OpenAI key. Used for audio/video transcription (Whisper) and when LLM_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=http://localhost:11434/v1   # e.g. Ollama

# Optional: keep the search index and study database in S3 (needs the 'aws' extra and AWS credentials).
# The API restores missing files at startup and saves changes every S3_SYNC_SECONDS.
# S3_BUCKET=my-study-mentor-bucket
# S3_PREFIX=ai-study-mentor
# S3_SYNC_SECONDS=30
